APP_NAME=FlexArena
# 'production' oculta los errores de PHP, que es lo que corresponde en un
# servidor: un stack trace en pantalla filtra rutas y consultas. Este archivo es
# el que install_almalinux.sh copia a .env cuando no existe, asi que el default
# seguro va aca. Para desarrollo local, ponelo en 'development' en TU .env
# —que esta en .gitignore— y vas a ver los errores en vez de una pagina en blanco.
APP_ENV=production
APP_URL=http://localhost:8080

# Puertos publicados al host por docker-compose.yml (app HTTP / app HTTPS / phpMyAdmin).
# HTTP (80) solo redirige a HTTPS (301) — nunca sirve contenido directo.
# HTTPS usa el certificado de ssl/certificate.crt + ssl/private.key (provisto por
# la institución); si no está presente todavía, el contenedor genera uno
# autofirmado temporal para desarrollo. Ver ssl/README.md.
# En desarrollo local (Windows, puerto 80 a veces ocupado por otra cosa),
# cambiá esto a 8080 si hace falta.
HTTP_PORT=80
HTTPS_PORT=443
PMA_HTTP_PORT=8081

DB_HOST=db
DB_PORT=3306
DB_NAME=flexarena
DB_USER=flexarena_user
# No dejes esto con el valor de ejemplo en un despliegue real — reemplazalo por
# una contraseña propia. install_almalinux.sh avisa si detecta que seguís con
# este valor.
DB_PASS=change_this_db_password
# Solo la usan la restauracion de respaldos y el acceso administrativo a MySQL.
# Si falta en .env, docker-compose.yml cae en este mismo valor de ejemplo y el
# root de la base queda con una contrasena publica. Ademas se fija en la PRIMERA
# inicializacion del volumen: cambiarla despues no tiene efecto sin recrear el
# volumen (`docker compose down -v`) o un ALTER USER a mano.
DB_ROOT_PASS=change_this_root_password

MYSQL_TIMEZONE=America/Argentina/Buenos_Aires
